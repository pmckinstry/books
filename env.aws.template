# AWS DynamoDB Configuration Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# Database Configuration
DATABASE_TYPE=dynamodb
DYNAMODB_LOCAL=false

# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Optional: AWS Profile (alternative to access keys)
# AWS_PROFILE=your_profile_name

# Optional: DynamoDB Endpoint (for testing or custom endpoints)
# AWS_DYNAMODB_ENDPOINT=https://dynamodb.us-west-2.amazonaws.com

# Security Notes:
# - Never commit this file with real credentials
# - Use IAM roles in production environments
# - Consider using AWS Secrets Manager for production
# - Rotate access keys regularly
# - This file is safe to commit as it contains no real credentials
